# Copy this file to .env and fill in your real values. Never commit .env.

# Supabase project (from Project Settings > API)
SUPABASE_URL=https://ozjhlvoojixudfkmysvd.supabase.co
SUPABASE_ANON_KEY=sb_publishable_ZjnD1QvBtbNWW0duuT5hmg_I4tKiAQ2

# Port the Express API listens on
PORT=4000

# Comma-separated list of allowed origins for CORS (your React app's URL(s))
CORS_ORIGINS=http://localhost:5173

# Optional: base URL to prefix relative filepath values from the database
# when they are not already full URLs (e.g. a Supabase Storage public URL base).
FILE_BASE_URL=

# Base URL of the SB Office management system's backend API (SB_OFFICE_SYSTEM/my-backend).
# Announcements/activities (content-posts) and schedules are managed there and
# fetched from its public endpoints, since that system locks anon Supabase
# access to those tables and enforces published=true itself.
MGMT_API_BASE_URL=http://localhost:5000
